# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model to use (default: claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# Optional: shell tool settings
SHELL_TOOL_ENABLED=true
SHELL_CONFIRM=true
SHELL_TIMEOUT_SECONDS=60

# Optional: where the agent stores memory, workspace files, and Google tokens
# AGENT_DATA_DIR=./data

# Optional: path to your Google OAuth client secret (see README.md)
# GOOGLE_CREDENTIALS_PATH=./data/credentials.json
